{
  "name": "smaran",
  "productName": "Smaran",
  "version": "3.3.15",
  "description": "Styled, always-on-top reminder popups shown in bursts on schedules.",
  "author": "SahajS",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && node scripts/prepare-release-dirs.mjs && electron-builder --win --x64 && node scripts/make-setup.mjs",
    "build:unpack": "npm run build && node scripts/prepare-release-dirs.mjs && electron-builder --win --x64 --dir",
    "icon": "node scripts/make-icon.mjs",
    "license:keygen": "node scripts/license-keygen.mjs",
    "license:sign": "node scripts/license-sign.mjs",
    "license:seal-key": "node scripts/license-seal-key.mjs",
    "license:core": "node scripts/build-license-core.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "date-fns": "^4.4.0",
    "font-list": "^2.1.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
